{
  "name": "makeon-umbrella",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "undici": "^7.29.1",
    "dompurify": "^3.4.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview:images": "node scripts/preview.mjs",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migrate:verify": "node --env-file=.env --conditions=react-server --import tsx scripts/verify-migrations.mjs",
    "cms:migrate:create": "payload migrate:create",
    "cms:bootstrap": "tsx scripts/bootstrap-commerce.ts",
    "test:commerce": "node --conditions=react-server --import tsx --test --test-force-exit tests/commerce/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "graphql": "^16.14.2",
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "payload": "^3.90.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.0.0"
  }
}
